html, body {
    background-color: #000000;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
    text-align: center;
}

.container {
    background-color: #181818;
    height: 64%;
    width: 64%;
    border-radius: 8px;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 32px;
}

.controls

#input

.hint {
    color: #ffffff;
    padding: 16px;
}






.row {
    padding: 16px;
}

.footer {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 16px;
}

.profile {
    height: 16px;
    width: 16px;
    padding-top: 16px;
    padding-right: 4px;
}

.notice {
    color: #fff;
    font-size: 16px;
    padding-top: 16px;
}

a {
    color: #3366cc
}