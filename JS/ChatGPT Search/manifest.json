{
  "manifest_version": 2,
  "name": "Custom Search Engine Context Menu",
  "version": "1.0",
  "description": "Add custom search engines to the context menu",
  "permissions": [
    "storage",
    "contextMenus",
    "tabs"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/default_icon.png",
    "48": "icons/default_icon.png",
    "128": "icons/default_icon.png"
  },
  "browser_action": {
    "default_popup": "options.html",  // Link to the options page when clicked
    "default_icon": "icons/default_icon.png"
  }
}